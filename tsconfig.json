{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ESNext",
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": false,
    "declaration": true,
    "outDir": "dist",
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "rootDir": "./src"
    // "strictNullChecks": true,
    // "exactOptionalPropertyTypes": true
  },
  "include": ["src/*.ts"],
  "exclude": ["src/experimentalGenerator.ts"]
}
